move_wire -wires {net_wire:mgt_clk_spine_bot_L3_inv2_Y/2} -delta {-0.00825 0}
move_wire -wires {net_wire:mgt_clk_spine_bot_L3_inv2_Y/2} -delta {0.00825 0}
move_wire -wires {net_wire:mgt_clk_spine_bot_L3_inv2_Y/2} -delta {0 0.72}
move_wire -wires {net_wire:mgt_clk_spine_bot_L3_inv2_Y/2} -delta {0 -0.72}
move_wire -wires {net_wire:mgt_clk_spine_bot_L3_inv2_Y/2} -delta {0 0.72}
