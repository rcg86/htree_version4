proc clk_output_conn {from_spine port spec layer} {
set op_buf [connect_spine -from [get_db spine $from] -to [get_db ports $port] -ref_cell INV12M3Mx2Fx7Dx_D96_N_S7P94TSL_C60L04 -source_spine_stub_distance 10 -name ${from}_ ]
route_pin -inst [lindex $ob_buf 0] -spec_name ${spec}_routing
route_net  -net [get_db [get_db insts [lindex $ob_buf 0]] .pins.net.name] -rule rule1 -shield -shield_nets {VDD_SOC, VSS} -force
promote_port_to_layer -width 0.72 -port $port -layer $layer
}
