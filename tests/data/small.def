# Synthetic DEF for read_def tests. Units 1000/um.
VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN top ;
UNITS DISTANCE MICRONS 1000 ;

PROPERTYDEFINITIONS
    DESIGN X STRING "has ; inside" ;
END PROPERTYDEFINITIONS

DIEAREA ( 0 0 ) ( 100000 0 ) ( 100000 50000 )
        ( 40000 * ) ( * 80000 ) ( 0 80000 ) ;

ROW r1 core 0 0 N DO 10 BY 1 STEP 100 0 ;
ROW r2 core 0 200 FS DO 10 BY 1 STEP 100 0 ;
TRACKS X 50 DO 1000 STEP 100 LAYER H1 ;
TRACKS Y 25 DO 800 STEP 100 MASK 2 SAMEMASK LAYER H2 M1 ; # WIDTH 192
TRACKS MASK 1 Y 75
  DO 800 STEP 100 LAYER H2 ;

COMPONENTS 1 ;
- u1 INV + PLACED ( 0 0 ) N ;
END COMPONENTS

PINS 6 ;
- a + NET a + DIRECTION INPUT + USE SIGNAL
  + LAYER H1 ( -50 0 ) ( 50 400 )
  + FIXED ( 10000 0 ) N ;
- y[0] + NET y[0] + DIRECTION OUTPUT + USE CLOCK
  + LAYER M1 MASK 2 SPACING 20 ( -50 0 ) ( 50 400 )
  + PLACED ( 100000 20000 ) W ;
- b + NET b + DIRECTION INOUT TRISTATE + USE SIGNAL
  + PORT
    + LAYER H1 ( 0 0 ) ( 100 200 )
    + FIXED ( 20000 0 ) FN
  + PORT
    + POLYGON H2 ( 0 0 ) ( 300 0 ) ( * 100 ) ( 0 100 )
    + VIA V12 ( 0 0 )
    + COVER ( 30000 80000 ) S ;
- c + NET c + DIRECTION FEEDTHRU + USE SIGNAL
  + LAYER H1 ( 0 0 ) ( 100 200 )
  + FIXED ( 0 30000 ) E ;
- d + NET d + DIRECTION INPUT
  + LAYER H1 ( 0 0 ) ( 100 200 )
  + FIXED ( 50000 50000 ) FE ;
- VDD + NET VDD + SPECIAL + DIRECTION INOUT + USE POWER ;
END PINS

NETS 1 ;
- a ( PIN a ) ( u1 A ) ;
END NETS

END DESIGN
